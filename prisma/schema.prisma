generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model University {
  id        String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name      String   @db.VarChar(255)
  shortName String?  @map("short_name") @db.VarChar(50)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users     User[]

  @@map("universities")
}

model Department {
  id        String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name      String   @db.VarChar(255)
  code      String?  @db.VarChar(50)
  years     Int?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users     User[]

  @@map("departments")
}

model User {
  id             String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  fullName       String        @map("full_name") @db.VarChar(255)
  headline       String?       @db.VarChar(50)
  telegramId     String?       @unique(map: "users_telegram_id_unique") @map("telegram_id") @db.VarChar(255)
  bio            String?       @db.Text
  profileImageId String?       @map("profile_image_id") @db.VarChar(255)
  universityId   String?       @map("university_id") @db.VarChar(36)
  departmentId   String?       @map("department_id") @db.VarChar(36)
  graduationYear Int?          @map("graduation_year")
  isActive       Boolean       @default(false) @map("is_active")
  isTeamMember   Boolean       @default(false) @map("is_team_member")
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt      DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  socialLinks    SocialLink[]
  projects       UserProject[]
  services       UserService[]
  department     Department?   @relation(fields: [departmentId], references: [id], onUpdate: NoAction, map: "users_department_id_departments_id_fk")
  university     University?   @relation(fields: [universityId], references: [id], onUpdate: NoAction, map: "users_university_id_universities_id_fk")

  @@index([departmentId], map: "users_department_id_departments_id_fk")
  @@index([universityId], map: "users_university_id_universities_id_fk")
  @@map("users")
}

model SocialLink {
  userId    String   @map("user_id") @db.VarChar(36)
  platform  String   @db.VarChar(50)
  username  String?  @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "social_links_user_id_users_id_fk")

  @@id([userId, platform])
  @@map("social_links")
}

model Service {
  id          String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  name        String        @db.VarChar(255)
  description String?       @db.VarChar(500)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users       UserService[]

  @@map("services")
}

model UserService {
  userId    String   @map("user_id") @db.VarChar(36)
  serviceId String   @map("service_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  service   Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_services_service_id_services_id_fk")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_services_user_id_users_id_fk")

  @@id([userId, serviceId])
  @@index([serviceId], map: "user_services_service_id_services_id_fk")
  @@map("user_services")
}

model UserProject {
  id           String        @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  userId       String        @map("user_id") @db.VarChar(36)
  postLink     String        @unique(map: "user_projects_post_link_unique") @map("post_link") @db.VarChar(255)
  embeddingKey String        @unique(map: "user_projects_embedding_key_unique") @map("embedding_key") @db.VarChar(255)
  tag          String        @db.VarChar(50)
  status       ProjectStatus @default(active)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "user_projects_user_id_users_id_fk")

  @@index([userId], map: "user_projects_user_id_users_id_fk")
  @@map("user_projects")
}

model LegacyWall {
  id           String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  title        String   @db.VarChar(255)
  description  String   @db.Text
  eventDate    DateTime @default(now()) @map("event_date") @db.Timestamp(0)
  contributors String   @db.LongText
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamp(0)

  @@map("legacy_wall")
}

model Podcast {
  id         String   @id @default(dbgenerated("(uuid())")) @db.VarChar(36)
  ses        Int
  eps        Int
  postLink   String   @unique(map: "podcasts_post_link_unique") @map("post_link") @db.VarChar(255)
  audioLink  String?  @unique(map: "podcasts_audio_link_unique") @map("audio_link") @db.VarChar(255)
  guest      String   @db.VarChar(255)
  streamDate DateTime @map("stream_date") @db.Date

  @@map("podcasts")
}

enum ProjectStatus {
  active
  inactive
  flaged
}
